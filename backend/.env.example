# KebabZilla Backend Environment Configuration
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./kebabzilla.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Initial Administrator Seed
SEED_ADMIN_EMAIL=admin@kebabzilla.local
SEED_ADMIN_PASSWORD=your_secure_password_here

# Razorpay Configuration (Test / Live)
# Get these from: Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=

# Google Authentication & Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=support@kebabzilla.in
SMTP_PASSWORD=
