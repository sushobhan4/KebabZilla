# KebabZilla Backend Environment Configuration
ENVIRONMENT=development
API_PREFIX=/api/v1

# Development (SQLite):
DATABASE_URL=sqlite:///./kebabzilla.db

# Supabase PostgreSQL (Free Tier - Session Pooler port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend CORS origins (comma-separated or JSON list):
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT Secret (Must be 32+ characters in production)
JWT_SECRET=local-development-secret-change-me-at-least-32-chars

# Initial Administrator Seed (runs on first startup if password is provided)
SEED_ADMIN_EMAIL=admin@kebabzilla.local
SEED_ADMIN_PASSWORD=your_secure_password_here

# Google Cloud Storage (Menu Image uploads)
GCS_BUCKET_NAME=kebabzilla_cloud_storage
GCS_PROJECT_ID=kebabzilla
GCS_MENU_IMAGES_FOLDER=menuImages

# Razorpay Configuration (Test / Live)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=

# Google Authentication & Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=support@kebabzilla.in
SMTP_PASSWORD=
