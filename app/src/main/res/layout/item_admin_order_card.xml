<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/brand_paper_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/brand_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: ID & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderCardId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/brand_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Order #KZ-9821" />

            <TextView
                android:id="@+id/tvOrderCardStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_open"
                android:fontFamily="@font/manrope"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/brand_emerald"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PREPARING" />

        </LinearLayout>

        <!-- Customer & Time -->
        <TextView
            android:id="@+id/tvOrderCustomerAndDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/brand_muted"
            android:textSize="12sp"
            tools:text="Rahul Sen (+91 98301 23456) · 15 mins ago" />

        <!-- Line Items Summary -->
        <TextView
            android:id="@+id/tvOrderItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/brand_ink"
            android:textSize="13sp"
            tools:text="2× Chicken Shawarma Roll, 1× Firni" />

        <!-- Address / Delivery Info -->
        <TextView
            android:id="@+id/tvOrderAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/brand_muted"
            android:textSize="11sp"
            tools:text="Flat 4B, Koramangala, Bengaluru" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/brand_line" />

        <!-- Bottom Row: Total & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textColor="@color/brand_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvOrderTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/brand_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="₹580 (COD)" />

            </LinearLayout>

            <!-- Refund Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderRefund"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/brand_error_container"
                android:fontFamily="@font/manrope"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Refund"
                android:textColor="@color/brand_error"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

            <!-- Action / Transition Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderStatusAction"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="@color/brand_red"
                android:fontFamily="@font/manrope"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Advance"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
