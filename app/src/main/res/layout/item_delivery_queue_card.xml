<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/brand_paper_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#FDE68A"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeliveryOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/brand_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Order #KZ-9812" />

            <TextView
                android:id="@+id/tvDeliveryStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:fontFamily="@font/manrope"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="#D97706"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="OUT FOR DELIVERY" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDeliveryCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/brand_muted"
            android:textSize="12sp"
            tools:text="Customer: Pritam Das (+91 98765 00000)" />

        <TextView
            android:id="@+id/tvDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/brand_ink"
            android:textSize="13sp"
            tools:text="Flat 201, Diamond City West, Bakrahat Road, Kolkata" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/brand_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeliveryTotalAndPay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/brand_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="₹480 · Cash to Collect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickVerifyOtp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/brand_emerald"
                android:fontFamily="@font/manrope"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Enter OTP"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
