<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutOptionCard"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_option_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Radio / Check Circle -->
    <ImageView
        android:id="@+id/ivOptionRadio"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="Option selection indicator"
        android:src="@drawable/ic_radio_dot_unchecked" />

    <!-- Option Name -->
    <TextView
        android:id="@+id/tvOptionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="@font/dm_sans"
        android:textColor="@color/brand_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Tikka" />

    <!-- Extra Price / Free -->
    <TextView
        android:id="@+id/tvOptionPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:textColor="@color/brand_muted"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="+₹65" />

</LinearLayout>