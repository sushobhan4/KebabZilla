<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/brand_paper_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/brand_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPastDeliveryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.04"
                android:textColor="@color/brand_emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="DELIVERED · 22 Oct, 09:30 PM" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:fontFamily="@font/manrope"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="DELIVERED"
                android:textColor="@color/brand_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPastDeliveryOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/brand_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Order #KZ-9812" />

        <TextView
            android:id="@+id/tvPastDeliveryCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/brand_muted"
            android:textSize="12sp"
            tools:text="Customer: Pritam Das (+91 98765 00000)" />

        <TextView
            android:id="@+id/tvPastDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/brand_ink"
            android:textSize="13sp"
            tools:text="Flat 201, Diamond City West, Bakrahat Road, Kolkata" />

        <TextView
            android:id="@+id/tvPastDeliveryItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/brand_muted"
            android:textSize="12sp"
            tools:text="2× Chicken Tikka, 1× Butter Naan" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/brand_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPastDeliveryTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/brand_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="₹480" />

            <TextView
                android:id="@+id/tvPastDeliveryPaymentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:fontFamily="@font/manrope"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/brand_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Paid Online" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
