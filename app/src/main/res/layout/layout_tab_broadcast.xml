<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Eyebrow & Title Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.08"
            android:text="MARKETING &amp; PROMOTIONS STUDIO"
            android:textColor="@color/brand_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope"
            android:text="Customer offers &amp; campaigns"
            android:textColor="@color/brand_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Design email campaigns with promo codes, discount highlights, and live interactive preview."
            android:textColor="@color/brand_muted"
            android:textSize="12sp" />

        <!-- Campaign Channel Selector Sub-tabs (Email vs SMS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_white"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnChannelEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_primary"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="✉ Email Campaigns"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnChannelSms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="💬 SMS / Flash (Dev)"
                android:textColor="@color/brand_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- SMS Under Development Banner (Hidden by default, shown when SMS selected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSmsNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FEF3C7"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#FDE68A"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="SMS Campaigns are Under Development"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Direct SMS marketing via DLT-approved sender IDs is currently being engineered. Email campaigns are fully operational."
                    android:textColor="#B45309"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Target Audience Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.06"
            android:text="1. TARGET AUDIENCE"
            android:textColor="@color/brand_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutAudienceChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAudienceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_primary"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="All Customers"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAudienceNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_white"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="New (0 Orders)"
                    android:textColor="@color/brand_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAudienceReturning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_white"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="Returning (1+ Orders)"
                    android:textColor="@color/brand_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Composer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCampaignComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/brand_paper_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/brand_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="2. Campaign Content"
                    android:textColor="@color/brand_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Subject -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Subject Line *"
                    android:textColor="@color/brand_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBroadcastSubject"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. A little something from KebabZilla"
                    android:inputType="textCapSentences"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/brand_ink"
                    android:textColorHint="@color/brand_muted"
                    android:textSize="13sp" />

                <!-- Headline & Subheading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hero Headline"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastHeadline"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="FLAVOUR UNLEASHED"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subheading"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastSubheading"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Authentic Charcoal Kebabs"
                            android:inputType="textCapSentences"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Promo Code & Discount Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Promo Voucher Code"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastPromoCode"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="e.g. KEBAB20"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discount Highlight"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastDiscount"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="e.g. 20% OFF"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Message Body -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Message Body *"
                    android:textColor="@color/brand_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBroadcastMessage"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:hint="Warm kebabs, fresh aromatics, and rich saffron biryani are ready for you this weekend."
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/brand_ink"
                    android:textColorHint="@color/brand_muted"
                    android:textSize="13sp" />

                <!-- CTA Button Text & URL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CTA Button Text"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastCtaText"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Order Fresh Kebabs"
                            android:inputType="textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target URL"
                            android:textColor="@color/brand_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etBroadcastCtaUrl"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="https://kebabzilla.in/store"
                            android:inputType="textUri"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/brand_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Live Card Preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/manrope"
                    android:letterSpacing="0.06"
                    android:text="LIVE EMAIL PREVIEW"
                    android:textColor="@color/brand_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/brand_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope"
                            android:letterSpacing="0.1"
                            android:text="KEBABZILLA"
                            android:textColor="@color/brand_red"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewHeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/manrope"
                            android:text="FLAVOUR UNLEASHED"
                            android:textColor="@color/brand_ink"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewSubheading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Authentic Charcoal Kebabs &amp; Fast Casual Dining"
                            android:textColor="@color/brand_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPreviewDiscount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_primary"
                                android:fontFamily="@font/manrope"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="20% OFF"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPreviewPromoCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pill_white"
                                android:fontFamily="@font/manrope"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="CODE: KEBAB20"
                                android:textColor="@color/brand_ink"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPreviewMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:text="Warm kebabs, fresh aromatics, and rich saffron biryani are ready for you this weekend."
                            android:textColor="@color/brand_ink"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewCta"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="@color/brand_red"
                            android:fontFamily="@font/manrope"
                            android:text="Order Fresh Kebabs →"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Dispatch CTA Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendBroadcast"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/brand_red"
                    android:fontFamily="@font/manrope"
                    android:text="Dispatch Campaign Broadcast"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Past Broadcasts Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.06"
            android:text="CAMPAIGN DISPATCH LOGS"
            android:textColor="@color/brand_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutPastBroadcasts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
