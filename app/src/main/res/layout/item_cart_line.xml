<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cart_item_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Item Image with Dietary Dot -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCartItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImageCorner"
            tools:srcCompat="@drawable/kebabzilla_mark" />

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:background="@drawable/bg_dietary_container">

            <ImageView
                android:id="@+id/ivCartDietaryIcon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:contentDescription="Dietary indicator"
                android:src="@drawable/ic_non_veg" />
        </FrameLayout>

    </FrameLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:textColor="@color/brand_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Galouti Kebab Melt" />

        <TextView
            android:id="@+id/tvCartItemVariation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/brand_muted"
            android:textSize="11sp"
            tools:text="Half · 4 Pcs" />

        <TextView
            android:id="@+id/tvCartItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/brand_red"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="₹280" />

    </LinearLayout>

    <!-- Stepper Pill -->
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_stepper_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCartMinus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Decrease quantity"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_remove"
            app:tint="@color/brand_ink" />

        <TextView
            android:id="@+id/tvCartQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:textColor="@color/brand_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="2" />

        <ImageView
            android:id="@+id/btnCartPlus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Increase quantity"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_add"
            app:tint="@color/brand_red" />

    </LinearLayout>

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/btnCartDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Delete item"
        android:focusable="true"
        android:padding="5dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/brand_muted_light" />

</LinearLayout>
