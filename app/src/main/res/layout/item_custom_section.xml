<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_section_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Section Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSectionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:textColor="@color/brand_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Kebab" />

        <!-- Tag: REQUIRED / OPTIONAL -->
        <TextView
            android:id="@+id/tvSectionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_required"
            android:fontFamily="@font/manrope"
            android:text="REQUIRED"
            android:textColor="@color/brand_red"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="REQUIRED" />

    </LinearLayout>

    <!-- Options Container -->
    <LinearLayout
        android:id="@+id/llSectionOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>