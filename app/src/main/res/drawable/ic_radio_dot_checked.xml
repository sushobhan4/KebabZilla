<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_red" />
            <solid android:color="@color/transparent" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <item
        android:bottom="3.5dp"
        android:left="3.5dp"
        android:right="3.5dp"
        android:top="3.5dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_red" />
            <size
                android:width="9dp"
                android:height="9dp" />
        </shape>
    </item>
</layer-list>