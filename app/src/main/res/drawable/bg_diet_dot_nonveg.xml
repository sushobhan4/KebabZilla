<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White Box with Red Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1.5dp"
                android:color="#AD493C" />
            <corners android:radius="6dp" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
    <!-- Solid Red Circle in the center -->
    <item
        android:bottom="6.5dp"
        android:left="6.5dp"
        android:right="6.5dp"
        android:top="6.5dp">
        <shape android:shape="oval">
            <solid android:color="#AD493C" />
            <size
                android:width="9dp"
                android:height="9dp" />
        </shape>
    </item>
</layer-list>